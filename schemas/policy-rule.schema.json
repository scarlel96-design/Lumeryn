{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lumeryn policy rule — design contract, not an enforcement engine",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "version",
    "enabled",
    "scope",
    "priority",
    "decision",
    "conditions"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "policy_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_-]{2,99}$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "enabled": {
      "type": "boolean"
    },
    "scope": {
      "enum": [
        "response",
        "search",
        "tool",
        "model",
        "module"
      ]
    },
    "priority": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000
    },
    "decision": {
      "enum": [
        "ALLOW",
        "ALLOW_WITH_CONDITIONS",
        "REVIEW",
        "REQUIRE_APPROVAL",
        "DENY"
      ]
    },
    "conditions": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "attribute",
          "operator",
          "value"
        ],
        "properties": {
          "attribute": {
            "type": "string",
            "maxLength": 200
          },
          "operator": {
            "enum": [
              "eq",
              "neq",
              "in",
              "not_in"
            ]
          },
          "value": {
            "type": [
              "string",
              "number",
              "boolean",
              "array",
              "null"
            ]
          }
        }
      }
    },
    "reason": {
      "type": "string",
      "maxLength": 1000
    }
  }
}
